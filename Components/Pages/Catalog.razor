@page "/catalog"
@using DataClient.Models
@using DataClient.Services.Interfaces
@inject ICatalogService Service
@attribute [StreamRendering]

<PageTitle>Catalog</PageTitle>

@if (_products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    foreach (var product in _products)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@product.Name</h5>
                <h6 class="card-subtitle mb-2 text-muted">@product.Manufacturer</h6>
                <p class="card-text">ID: @product.Id</p>
                <p class="card-text">Image URL: @product.ImageUrl</p>
                <p class="card-text">Product URL: @product.ProductUrl</p>
                <p class="card-text">Price: @product.Price</p>
                <p class="card-text">Brand: @product.Brand</p>
                <p class="card-text">Description: @product.Description</p>
                <p class="card-text">Model: @product.Model</p>
                <p class="card-text">Release date: @product.ReleaseDate</p>
                <p class="card-text">Expiry date: @product.ExpiryDate</p>
            </div>
        </div>
    }
}

@code {
    List<Product> _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await Service.GetProducts();
    }

}
